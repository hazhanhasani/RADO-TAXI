Options -Indexes
DirectoryIndex index.php
<FilesMatch "^RADO-cPanel.*\.zip$">
    Require all denied
</FilesMatch>
RewriteEngine On
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# Route every public API endpoint directly to its PHP entrypoint.
# This avoids Apache DirectorySlash redirects, which can turn POST into GET.
RewriteRule ^api/app-updates/(passenger|driver)/?$ api/app-updates/index.php?app=$1 [L,QSA]
RewriteRule ^api/v1/maps/reverse/?$ api/health/index.php?service=reverse [L,QSA]
RewriteRule ^api/v1/maps/route/?$ api/v1/maps/route/index.php [L,QSA]
RewriteRule ^api/v1/maps/search/?$ api/v1/maps/search/index.php [L,QSA]
RewriteRule ^api/v1/fare/estimate/?$ api/v1/fare/estimate/index.php [L,QSA]
RewriteRule ^api/v1/trips/?$ api/v1/trips/index.php [L,QSA]
RewriteRule ^api/v1/trips/status/?$ api/v1/trips/status/index.php [L,QSA]
RewriteRule ^api/v1/trips/change/?$ api/v1/trips/change/index.php [L,QSA]
RewriteRule ^api/v1/realtime/?$ api/v1/realtime/index.php [L,QSA]
RewriteRule ^api/v1/platform/?$ api/v1/platform/index.php [L,QSA]
RewriteRule ^api/v1/driver/session/?$ api/v1/driver/session/index.php [L,QSA]
RewriteRule ^api/v1/driver/presence/?$ api/v1/driver/presence/index.php [L,QSA]
RewriteRule ^api/v1/driver/offers/?$ api/v1/driver/offers/index.php [L,QSA]
RewriteRule ^api/v1/driver/trip/?$ api/v1/driver/trip/index.php [L,QSA]
RewriteRule ^api/v1/driver/wallet/?$ api/v1/driver/wallet/index.php [L,QSA]
RewriteRule ^api/v1/driver/documents/?$ api/v1/driver/documents/index.php [L,QSA]
RewriteRule ^share/([A-Fa-f0-9]{48})/?$ share/index.php?token=$1 [L,QSA]
RewriteRule ^rado-system/ - [F,L]
