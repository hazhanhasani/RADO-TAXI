Options -Indexes
DirectoryIndex index.php
<FilesMatch "^RADO-cPanel.*\.zip$">
    Require all denied
</FilesMatch>
RewriteEngine On
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
RewriteRule ^api/app-updates/(passenger|driver)/?$ api/app-updates/index.php?app=$1 [L,QSA]
RewriteRule ^api/v1/maps/reverse/?$ api/health/index.php?service=reverse [L,QSA]
RewriteRule ^api/v1/driver/session/?$ api/v1/driver/session/index.php [L,QSA]
RewriteRule ^api/v1/driver/presence/?$ api/v1/driver/presence/index.php [L,QSA]
RewriteRule ^api/v1/driver/offers/?$ api/v1/driver/offers/index.php [L,QSA]
RewriteRule ^api/v1/driver/trip/?$ api/v1/driver/trip/index.php [L,QSA]
RewriteRule ^api/v1/driver/wallet/?$ api/v1/driver/wallet/index.php [L,QSA]
RewriteRule ^api/v1/trips/status/?$ api/v1/trips/status/index.php [L,QSA]
RewriteRule ^rado-system/ - [F,L]
